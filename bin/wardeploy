#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/wardeploy.env"

CMD="${1:-}"; shift || true

case "$CMD" in
  deploy)
    WAR_PATH="${1:-}"
    [[ -n "$WAR_PATH" ]] || { echo "사용법: wardeploy deploy <war경로>"; exit 1; }
    bash "$ROOT_DIR/scripts/deploy.sh" "$WAR_PATH"
    ;;
  rollback)
    bash "$ROOT_DIR/scripts/rollback.sh"
    ;;
  status)
    bash "$ROOT_DIR/scripts/status.sh"
    ;;
  up)
    bash "$ROOT_DIR/scripts/up.sh"
    ;;
  down)
    bash "$ROOT_DIR/scripts/down.sh"
    ;;
  *)
    echo "사용법: wardeploy {up|down|deploy|rollback|status}"
    exit 1;;
esac
